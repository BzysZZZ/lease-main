<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qianlou.app.mapper.NoticeInfoMapper">

    <select id="getNoticeItem" resultType="com.qianlou.app.vo.NoticeItemVo">
        select id,
               notice_type,
               title,
               content,
               read_status, lease_id, remark
        from notice
        where is_deleted=0
        and notice.user_id=#{userId}
    </select>
</mapper>
